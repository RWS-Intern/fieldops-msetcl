# @firebase/rules-unit-testing@5 declares a peer of firebase@^12, but these
# tests deliberately run against firebase@10.14.1 — the exact client version
# the app ships (see the main package.json). Rule evaluation is driven by the
# query shapes the client sends, so testing with a different major than the app
# uses would weaken the check. The peer mismatch is knowingly accepted; this
# is the combination the suite was written and verified against.
#
# Scoped to this directory, so it has no effect on the app's own installs.
legacy-peer-deps=true
