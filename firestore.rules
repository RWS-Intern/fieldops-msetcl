rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAuthenticated() {
      return request.auth != null;
    }

    function isAdmin() {
      return isAuthenticated() &&
        get(/databases/$(database)/documents/users/$(request.auth.uid))
          .data.role == 'admin';
    }

    // Read-only observer. Sees everything an admin sees (unscoped), and is
    // admitted to `get`/`list`/`read` branches ONLY — never to a create,
    // update or delete branch anywhere in this file.
    //
    // The exists() guard makes this function TOTAL: for a session whose user
    // document is missing, get() returns null and `.data.role` would error,
    // and an error inside an `&&` propagates. Every write branch below is
    // hardened with `&& !isViewer()`, so a non-total isViewer() would turn
    // "allowed" into "error → denied" for those sessions and change existing
    // behaviour. With exists() it returns plain false instead.
    //
    // exists() and get() on the SAME document count as one document access,
    // and isAdmin() reads that same document, so this adds no billed read and
    // no extra lookup against the 10-access ceiling.
    function isViewer() {
      return isAuthenticated() &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid))
          .data.role == 'viewer';
    }

    // ── Approval-chain write integrity ─────────────────────────────────────────
    //
    // The approver branch's hasOnly([...]) fence says WHICH fields may change.
    // It says nothing about what they may change TO, and that gap is exploitable:
    // the live stage owner could write approverUid = themselves and then approve
    // every remaining stage alone, or forge a DIFFERENT stage's entry in
    // approvalStages[] while legitimately submitting their own.
    //
    // Checking "approverUid is one of approvalStageOwnerUids" does NOT close it —
    // the acting owner is themselves one of those uids. The handover target must
    // be the specific NEXT stage's nominated owner, read from the PRE-write
    // document, which the acting owner cannot influence.
    //
    // Both collections share these two functions; neither is used anywhere else.

    /**
     * Every stage entry except the one being acted on must be byte-identical to
     * its pre-write value (Map == Map is deep equality — verified in the
     * emulator, not assumed).
     *
     * FIXED AT THREE STAGES — see SURVEY_APPROVAL_STAGES in
     * src/lib/approvalStages.ts. size() == 3 is required on both sides so a
     * document with an unexpected chain length is refused outright rather than
     * silently passing a check that skipped indices. If a stage is ever added or
     * removed, THIS FUNCTION MUST GAIN OR LOSE A LINE — the failure mode is a
     * loud refusal of all transitions, which is the safe direction.
     */
    function chainStagesUnchangedExceptLive(before, after, liveIndex) {
      let b = before.approvalStages;
      let a = after.approvalStages;
      return b.size() == 3 && a.size() == 3
        && (liveIndex == 0 || b[0] == a[0])
        && (liveIndex == 1 || b[1] == a[1])
        && (liveIndex == 2 || b[2] == a[2]);
    }

    /**
     * A stage entry reset so its owner must reconsider. Identity and ROUTING
     * are pinned — stageKey/stageLabel/ownerUid/ownerName — while the three
     * result fields (reviewNotes/attachmentUrl/actedAt) are deliberately left
     * free: a stage going back to 'pending' has no result yet, and clearing
     * them carries no authority. ownerUid is the field that matters, and it
     * cannot move.
     */
    function isResetToPending(beforeStage, afterStage) {
      return afterStage.status   == 'pending'
        && afterStage.stageKey   == beforeStage.stageKey
        && afterStage.stageLabel == beforeStage.stageLabel
        && afterStage.ownerUid   == beforeStage.ownerUid
        && afterStage.ownerName  == beforeStage.ownerName;
    }

    /**
     * The ONE narrow exception to "only the live stage may change": a Disagree
     * writes its own entry AND resets liveIndex + 1 to 'pending'. Nothing else
     * may move, and liveIndex + 1 may only move in the reset shape above.
     *
     * liveIndex is fenced to 0..1 because liveIndex + 1 must exist.
     */
    function chainStagesUnchangedExceptLiveAndNext(before, after, liveIndex) {
      let b = before.approvalStages;
      let a = after.approvalStages;
      return b.size() == 3 && a.size() == 3
        && liveIndex >= 0 && liveIndex <= 1
        && (liveIndex == 0 || b[0] == a[0])
        && (liveIndex == 1 || liveIndex == 0 || b[1] == a[1])
        && (liveIndex == 2 || liveIndex == 1 || b[2] == a[2])
        && isResetToPending(b[liveIndex + 1], a[liveIndex + 1]);
    }

    /**
     * Normal top-down progression (reviewDirection == 'forward' before the
     * write). Four shapes; the acting owner's own stage entry stays
     * unconstrained, as before.
     */
    function isForwardTransition(before, after, afterDir, stages, live, last) {
      return (
          // F1 - approve a NON-final stage: advance exactly one and hand over
          // to exactly the next stage's nominated owner. This is the branch
          // that makes routing-to-self impossible.
          (after.status == 'pending_approval'
            && live < last
            && after.currentStageIndex == live + 1
            && after.approverUid == stages[live + 1].ownerUid
            && afterDir == 'forward')
          // F2 - approve the LAST stage: chain complete, nobody owns it now.
          || (after.status == 'approved'
            && live == last
            && after.currentStageIndex == stages.size()
            && after.approverUid == null
            && afterDir == 'forward')
          // F3 - Level 1 requests changes. Nothing below it to escalate to, so
          // this goes straight to the field, unchanged from before this phase.
          || (after.status == 'changes_requested'
            && live == 0
            && after.currentStageIndex == live
            && after.approverUid == before.approverUid
            && afterDir == 'forward')
          // F4 - a stage ABOVE Level 1 requests changes: the escalation
          // cascade BEGINS. Top-level status deliberately stays
          // 'pending_approval' - the field must not see this yet - while the
          // flag moves DOWN one stage for that owner to review.
          || (after.status == 'pending_approval'
            && live > 0
            && after.currentStageIndex == live - 1
            && after.approverUid == stages[live - 1].ownerUid
            && afterDir == 'backward')
        )
        && chainStagesUnchangedExceptLive(before, after, live);
    }

    /**
     * An escalation review in progress (reviewDirection == 'backward' before
     * the write): the flag is travelling down toward Level 1.
     *
     * THREE shapes only. There is deliberately no "reconsider and approve"
     * branch here: a Disagree flips the direction back to 'forward' as part of
     * its own write, so the bounced-to stage's next action — approve, or
     * re-reject — is an ordinary forward transition (F1/F2, or F4) evaluated by
     * isForwardTransition. Keeping that case out of here is what makes the
     * backward side three branches instead of five.
     */
    function isBackwardTransition(before, after, afterDir, stages, live, last) {
      return (
        (
          // B1 - AGREE at Level 1. The flag has reached the bottom, so now it
          // reaches the field, and the chain returns to normal progression.
          (after.status == 'changes_requested'
            && live == 0
            && after.currentStageIndex == live
            && after.approverUid == before.approverUid
            && afterDir == 'forward')
          // B2 - AGREE above Level 1: pass the flag one stage further down.
          || (after.status == 'pending_approval'
            && live > 0
            && after.currentStageIndex == live - 1
            && after.approverUid == stages[live - 1].ownerUid
            && afterDir == 'backward')
        )
        && chainStagesUnchangedExceptLive(before, after, live)
      ) || (
        // B3 - DISAGREE: bounce the flag back UP one stage, reset that stage to
        // 'pending' so its owner must reconsider, and return the chain to
        // 'forward'. The only transition in this model that writes an index
        // other than the live one, which is why it is the one branch using the
        // widened stages check.
        (after.status == 'pending_approval'
          && live < last
          && after.currentStageIndex == live + 1
          && after.approverUid == stages[live + 1].ownerUid
          && afterDir == 'forward')
        && chainStagesUnchangedExceptLiveAndNext(before, after, live)
      );
    }

    /**
     * Exactly one well-formed transition, keyed on the direction the chain was
     * travelling BEFORE the write. Everything is measured against the pre-write
     * document, which the acting owner cannot influence.
     *
     * afterDir uses .get(..., 'forward') so a chain document written before
     * reviewDirection existed still transitions normally: absent reads as
     * 'forward', which is exactly what those documents were doing. A write that
     * needs 'backward' must therefore set the field explicitly.
     */
    function isValidStageTransition(before, after) {
      let stages   = before.approvalStages;
      let live     = before.currentStageIndex;
      let last     = stages.size() - 1;
      let dir      = before.get('reviewDirection', 'forward');
      let afterDir = after.get('reviewDirection', 'forward');
      return live >= 0 && live <= last
        && (
          (dir == 'forward' && isForwardTransition(before, after, afterDir, stages, live, last))
          || (dir == 'backward' && isBackwardTransition(before, after, afterDir, stages, live, last))
        );
    }

    /**
     * Gate applied to the approver branch on both collections. A write that
     * touches none of the chain fields is left exactly as permissive as before
     * (this is what keeps pre-chain documents, which have no approvalStages at
     * all, writable by their single approver — `true || <error>` absorbs the
     * missing-field error, verified in the emulator).
     *
     * reviewDirection is in the hasAny list so a write that changes ONLY the
     * direction — with no accompanying transition — is forced through
     * isValidStageTransition and denied there.
     */
    function isValidChainWrite(before, after) {
      return !after.diff(before).affectedKeys()
                .hasAny(['approvalStages', 'currentStageIndex', 'approverUid', 'approverName', 'reviewDirection'])
        || isValidStageTransition(before, after);
    }

    /**
     * Resubmission RESTARTS THE WHOLE CHAIN at Approver Level 1 — it no longer
     * resumes at the stage that flagged it. The engineer may therefore move
     * currentStageIndex and approverUid, which their branch previously pinned
     * outright, so the target is pinned instead to stages[0].ownerUid read
     * from the PRE-write document: they still cannot route the survey to
     * themselves or to anyone off the chain.
     *
     * approvalStages is pinned UNCHANGED. Every stage's recorded flag is
     * permanent history; each stage overwrites its own entry when it next acts.
     */
    function isChainRestart(before, after) {
      let stages = before.get('approvalStages', []);
      return stages.size() > 0
        && after.status == 'pending_approval'
        && after.get('approvalStages', []) == stages
        && after.get('currentStageIndex', 0) == 0
        && after.approverUid == stages[0].ownerUid
        && after.get('reviewDirection', 'forward') == 'forward';
    }

    /**
     * The engineer branch's chain guard: either nothing chain-related moves at
     * all (drafts, saves, pre-chain documents), or it is exactly a restart.
     */
    function isValidEngineerChainWrite(before, after) {
      return (
        after.approverUid == before.approverUid
        && after.get('approvalStages', []) == before.get('approvalStages', [])
        && after.get('currentStageIndex', 0) == before.get('currentStageIndex', 0)
        && after.get('reviewDirection', 'forward') == before.get('reviewDirection', 'forward')
      ) || isChainRestart(before, after);
    }

    match /tasks/{taskId} {
      // Any authenticated user can read tasks.
      // Write access remains restricted — field engineers can only update
      // tasks assigned to them. The UI enforces per-user visibility via
      // query filters (assignedTo) in useTasks.ts; rules do not need to
      // duplicate that logic for reads. This change is required so that
      // updateProjectStatus can query tasks by projectId from any
      // authenticated session (including field engineers), because that
      // query may match tasks assigned to other engineers.
      allow read: if isAuthenticated();
      allow create: if isAdmin();
      // !isViewer() on the assignee branch: a field engineer who is demoted
      // to viewer keeps assignedTo == their uid on every task they held, so
      // without this a viewer could still write to that leftover work.
      allow update: if isAdmin()
                    || (resource.data.assignedTo == request.auth.uid && !isViewer());

      match /updates/{updateId} {
        allow read: if isAuthenticated();
        allow create: if isAuthenticated() && !isViewer();
        allow update, delete: if false;
      }
    }

    match /users/{userId} {
      // Viewers are covered by isAuthenticated() — they need the full user
      // list for the Engineers page and the Reports engineer filter.
      allow read: if isAuthenticated() || request.auth.uid == userId;
      // Admins can create any user document.
      // A newly signed-up user creates their OWN document (userId == their UID)
      // as the last step of accepting an invite. This is safe: the role field
      // comes from the invite, not from user input.
      allow create: if isAdmin() || request.auth.uid == userId;
      // Self-UPDATE is admin-only. Nothing in the app updates a user's own
      // document (see SignupPage.tsx — create only), and leaving the self
      // branch on update would let a viewer (or any other role) rewrite their
      // own `role` field and escalate straight past every rule in this file.
      allow update, delete: if isAdmin();
    }

    match /taskMaster/{typeId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    match /auditLog/{logId} {
      allow read: if isAdmin() || isViewer();
      // Viewers take no auditable action, so they write no audit entries.
      allow create: if isAuthenticated() && !isViewer();
      allow update, delete: if false;
    }

    match /appConfig/{docId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    // ── Vendors ────────────────────────────────────────────────────────────────
    //
    // The contracting organisations field engineers belong to, kept so
    // performance and reporting can be broken down vendor-wise.
    //
    // Read by every authenticated session: the Engineers list and the Reports
    // filters render an engineer's vendor, and a field engineer may read the
    // one their own account points at. No vendor field is sensitive.
    match /vendors/{vendorId} {
      allow read: if isAuthenticated();
      // Only an admin curates the list. No other role reaches a write branch
      // here at all, so the !isViewer() hardening used elsewhere is redundant.
      allow create, update: if isAdmin();
      // Hard delete is admin-only and NEVER the in-house vendor: that one is
      // the fallback every engineer without an outsourced vendor belongs to,
      // and it is pinned here by document id rather than left to the UI.
      //
      // Rules cannot check whether engineers still reference a vendor — that
      // needs a collection query — so deleteVendor in useVendorActions.ts
      // counts them and makes the admin confirm. Archiving stays the
      // non-destructive option for a vendor still in use.
      allow delete: if isAdmin() && vendorId != 'in-house';
    }

    match /projects/{projectId} {
      allow read: if isAuthenticated();
      allow create: if isAdmin();
      // The authenticated branch exists for updateProjectStatus, which any
      // field engineer's submission triggers. Viewers submit nothing.
      allow update: if isAdmin() || (isAuthenticated() && !isViewer());
      allow delete: if false;
    }

    match /invites/{inviteId} {
      // UUID is unguessable — public read is safe and required for the signup page.
      allow read: if true;
      allow create: if isAdmin();
      // Accepted by the new user (unauthenticated at the moment of acceptance),
      // or revoked/updated by an admin.
      allow update: if isAdmin() || (isAuthenticated() && !isViewer());
      allow delete: if isAdmin();
    }

    // ── v3.0 collections ───────────────────────────────────────────────────────

    match /sites/{siteId} {
      // Any authenticated user can read sites (field engineers need site
      // details; viewers browse every site).
      allow read: if isAuthenticated();
      // Only admins may create or delete site documents.
      allow create: if isAdmin();
      allow delete: if isAdmin();
      // Admins may update any field.
      // Field engineers may ONLY update the task-status counter fields and
      // site.status — written atomically by submitSiteTaskUpdate's transaction
      // when a task is submitted.  All other site fields remain admin-only.
      // Viewers never submit a task, so they never reach this branch.
      allow update: if isAdmin() ||
        (isAuthenticated() && !isViewer() &&
         request.resource.data.diff(resource.data)
           .affectedKeys()
           .hasOnly([
             'completedTaskCount',
             'inProgressTaskCount',
             'blockedTaskCount',
             'pendingApprovalTaskCount',
             'status',
             'location',
             'updatedAt',
           ]));
    }

    match /siteTasks/{taskId} {
      // Split get vs list to enforce document-level isolation for field engineers
      // while keeping list queries working for both roles.
      //
      // get  (single-document read by ID): admin and viewer see all; field
      //       engineer sees only tasks explicitly assigned to them.
      //       resource.data is safe in get rules.
      //
      // list (collection query): any authenticated user may run a query.
      //       Field-engineer isolation is enforced at the query layer via
      //       where('assignedTo', '==', uid) in useAssignedSiteTasks.ts.
      //       Admin queries (useSiteTasks / useSiteTaskActions) run under admin
      //       sessions and use their own query filters. Viewer oversight pages
      //       reuse those same unfiltered admin queries.
      //
      // This pattern avoids the isAdmin()+resource.data+OR combination that causes
      // Firestore to reject field-engineer list queries with permission-denied.
      allow get:  if isAdmin() || isViewer() || resource.data.assignedTo == request.auth.uid;
      allow list: if isAuthenticated();
      // Write access remains restricted — admins only for create/delete,
      // field engineers can update only tasks explicitly assigned to them.
      allow create: if isAdmin();
      allow update: if isAdmin()
                    // Engineer branch — may only move the task through the
                    // engineer-owned lifecycle states. 'completed' is reachable
                    // ONLY via the approver branch below. Ownership fields
                    // (assignedTo/approverUid) must be unchanged from this
                    // branch — otherwise an engineer could name themselves
                    // approver and self-approve. !isViewer() because a demoted
                    // engineer keeps assignedTo == their uid on old work.
                    || (isAuthenticated() && !isViewer()
                        && resource.data.assignedTo == request.auth.uid
                        && request.resource.data.status in ['in_progress', 'pending_approval', 'blocked']
                        && request.resource.data.assignedTo == resource.data.assignedTo
                        && request.resource.data.get('approverUid', null) == resource.data.get('approverUid', null))
                    // Approver branch — the assigned approver (or an admin, when the
                    // task has no approver, as a legacy-safety fallback) may update
                    // ONLY the review fields, and only into a review-terminal
                    // status. They must never touch the engineer's answers or photos.
                    // !isViewer() because a demoted approver keeps approverUid ==
                    // their uid on everything still awaiting their review.
                    || (isAuthenticated() && !isViewer()
                        && (resource.data.get('approverUid', null) == request.auth.uid
                            || (isAdmin() && resource.data.get('approverUid', null) == null))
                        && request.resource.data.status in ['completed', 'changes_requested']
                        && request.resource.data.diff(resource.data)
                             .affectedKeys()
                             .hasOnly([
                               'status',
                               'reviewNotes',
                               'reviewedBy',
                               'reviewedByName',
                               'reviewedAt',
                               'updatedAt',
                             ]));
      allow delete: if isAdmin();

      // Immutable submission/review snapshots — written by submitSiteTaskUpdate
      // (the assigned engineer) and reviewSiteTask (the nominated approver, or
      // an admin when the task has no approver). Both writers must be able to
      // create, which is why this mirrors the surveyReports/updates rule rather
      // than checking assignedTo alone.
      //
      // This block exists because the recursive /{path=**}/updates rule at the
      // bottom of the file no longer grants create to anyone: that blanket
      // grant was what let any authenticated account append a forged entry to
      // any audit trail. This path had no nested rule of its own and relied on
      // it entirely, so the create grant is restated here, scoped to the two
      // parties who legitimately write it.
      //
      // .get(field, null) on both ownership fields so a document missing either
      // one evaluates to false rather than erroring the whole rule.
      //
      // read is deliberately IDENTICAL to what the recursive rule already
      // granted (admin + viewer) — restated here only so this block is
      // self-describing. Field engineers could not read these before and still
      // cannot; the Reports page's collectionGroup('updates') query continues
      // to be served by the recursive rule, which is why its read stays.
      match /updates/{updateId} {
        allow read: if isAdmin() || isViewer();
        allow create: if !isViewer() && (isAdmin()
          || get(/databases/$(database)/documents/siteTasks/$(taskId)).data.get('assignedTo', null)  == request.auth.uid
          || get(/databases/$(database)/documents/siteTasks/$(taskId)).data.get('approverUid', null) == request.auth.uid);
        allow update, delete: if false;   // immutable audit trail
      }
    }

    // ── MSETCL Substation Visibility Project — WorkOrder + Survey ──────────────
    // Neither collection has legacy data (nothing has been deployed yet), so
    // unlike siteTasks there is no null-approver admin fallback to preserve —
    // the unconditional isAdmin() branch already covers that case.
    //
    // Least-privilege list/get: only admin, viewer, the assigned engineer, or
    // an approval-chain stage owner may read a document at all (siteTasks still
    // allows any authenticated user to `list` — that is NOT repeated here).
    // Firestore evaluates `list` per returned document, so this forces every
    // caller without a blanket role to include a matching `where` clause; see
    // the composite indexes in firestore.indexes.json for the assignedTo/
    // approverUid + status + updatedAt queries.
    //
    // READ is granted to ANY of the three stage owners, present or past, via
    // the flat approvalStageOwnerUids array — an `in` check against a flat
    // array costs nothing and works identically in `get` and `list`, which
    // testing a nested field across array elements does not. A stage owner
    // therefore keeps read access to a survey after their own stage clears
    // (they can see what happened to what they approved) while WRITE stays
    // exactly as tight as before: only approverUid == uid, the live stage.
    //
    // `.get('approvalStageOwnerUids', [])` rather than a bare field access:
    // documents written before the chain existed have no such field, and a
    // bare access on a missing field is a rule evaluation error, not false.
    // The pre-existing approverUid branch is KEPT alongside it so those
    // documents stay readable by their single approver — this is purely
    // additive, no read that worked before is removed.
    //
    // Field-manager scoping (zone/team) is NOT implemented here — task 5.

    match /workOrders/{workOrderId} {
      allow get:  if isAdmin()
                  || isViewer()
                  || resource.data.assignedTo  == request.auth.uid
                  || resource.data.approverUid == request.auth.uid
                  || request.auth.uid in resource.data.get('approvalStageOwnerUids', []);
      allow list: if isAdmin()
                  || isViewer()
                  || resource.data.assignedTo  == request.auth.uid
                  || resource.data.approverUid == request.auth.uid
                  || request.auth.uid in resource.data.get('approvalStageOwnerUids', []);
      // The admin pre-creates the blank work order (+ paired survey, in the
      // same batch — see useWorkOrderActions.ts). Engineers never create,
      // only update — this is what makes the offline-draft model work: the
      // target document already exists before the engineer goes offline.
      allow create: if isAdmin();
      allow update: if isAdmin()
                    // Engineer branch — may only move the work order through
                    // the engineer-owned lifecycle states; 'approved'/'closed'
                    // are reachable only via the approver/admin branches.
                    // Ownership fields must be unchanged from this branch —
                    // otherwise an engineer could name themselves approver
                    // and self-approve. The two chain fields are pinned the
                    // same way: an engineer owns the survey's CONTENT, never
                    // its approval record, and without these they could submit
                    // a payload marking stages approved that never were.
                    //
                    // .get(field, default) rather than a bare access because
                    // pre-chain documents have neither field, and a bare access
                    // on a missing field is an evaluation error — which inside
                    // an && chain would deny an ordinary submit on those
                    // documents. Verified both ways in the emulator.
                    //
                    // Deliberately an equality pin, NOT a hasOnly allowlist of
                    // survey-content fields: an allowlist would need editing
                    // every time the survey gains a field. This says nothing
                    // about what an engineer may write, only that these fields
                    // may not CHANGE — and a normal wizard payload never
                    // mentions them, so Firestore leaves them untouched and the
                    // comparison is trivially satisfied.
                    || (isAuthenticated() && !isViewer()
                        && resource.data.assignedTo == request.auth.uid
                        && request.resource.data.status in ['in_progress', 'pending_approval']
                        && request.resource.data.assignedTo  == resource.data.assignedTo
                        && isValidEngineerChainWrite(resource.data, request.resource.data))
                    // Approver branch — the LIVE stage owner may update only the
                    // workflow status plus the stage-transition fields.
                    // approverUid/approverName are in the allowlist because
                    // approving a non-final stage hands the document to the next
                    // stage's owner, so they now change on every transition
                    // rather than once.
                    //
                    // 'pending_approval' is a permitted RESULT status because
                    // approving a non-final stage leaves the document still
                    // awaiting approval — by the next stage's owner. It is safe
                    // only in combination with isValidChainWrite below, which
                    // pins that shape exactly; do not keep one without the other.
                    || (isAuthenticated() && !isViewer()
                        && resource.data.approverUid == request.auth.uid
                        && request.resource.data.status in ['approved', 'changes_requested', 'pending_approval']
                        && request.resource.data.diff(resource.data)
                             .affectedKeys()
                             .hasOnly([
                               'status',
                               'approvalStages',
                               'currentStageIndex',
                               'approverUid',
                               'approverName',
                               'reviewDirection',
                               'updatedAt',
                             ])
                        && isValidChainWrite(resource.data, request.resource.data));
      allow delete: if isAdmin();
    }

    match /surveyReports/{reportId} {
      // assignedTo/approverUid are denormalised directly onto SurveyReport
      // (kept in sync with the parent WorkOrder by useWorkOrderActions.ts) —
      // NOT looked up via the parent. Firestore can't filter a query on a
      // parent document's field, and a rule-level get() on the parent is a
      // billed read per document evaluated, which multiplies across a list
      // query and can hit the 10-lookup ceiling.
      // Read is granted to any present-or-past stage owner — see the long note
      // above the workOrders block for why this uses a flat uid array.
      allow get:  if isAdmin()
                  || isViewer()
                  || resource.data.assignedTo  == request.auth.uid
                  || resource.data.approverUid == request.auth.uid
                  || request.auth.uid in resource.data.get('approvalStageOwnerUids', []);
      allow list: if isAdmin()
                  || isViewer()
                  || resource.data.assignedTo  == request.auth.uid
                  || resource.data.approverUid == request.auth.uid
                  || request.auth.uid in resource.data.get('approvalStageOwnerUids', []);
      allow create: if isAdmin();
      allow update: if isAdmin()
                    // Engineer branch — same lifecycle + anti-self-reassignment
                    // guard as workOrders above, and the same equality pin on
                    // the two chain fields (see that branch for the full
                    // reasoning, including why .get(field, default) is used).
                    || (isAuthenticated() && !isViewer()
                        && resource.data.assignedTo == request.auth.uid
                        && request.resource.data.status in ['in_progress', 'pending_approval']
                        && request.resource.data.assignedTo  == resource.data.assignedTo
                        && isValidEngineerChainWrite(resource.data, request.resource.data))
                    // Approver branch — the LIVE stage owner may update ONLY the
                    // review fields plus the stage-transition fields. They must
                    // never touch the engineer's answers or photos. See the
                    // workOrders approver branch for why approverUid/approverName
                    // are writable and why 'pending_approval' is a permitted
                    // result status — both hold only alongside isValidChainWrite.
                    || (isAuthenticated() && !isViewer()
                        && resource.data.approverUid == request.auth.uid
                        && request.resource.data.status in ['approved', 'changes_requested', 'pending_approval']
                        && request.resource.data.diff(resource.data)
                             .affectedKeys()
                             .hasOnly([
                               'status',
                               'reviewNotes',
                               'reviewedBy',
                               'reviewedByName',
                               'reviewedAt',
                               'approvalStages',
                               'currentStageIndex',
                               'approverUid',
                               'approverName',
                               'reviewDirection',
                               'updatedAt',
                             ])
                        && isValidChainWrite(resource.data, request.resource.data));
      allow delete: if isAdmin();

      // Immutable audit trail — see submitSurvey/reviewSurvey in
      // useSurveyActions.ts. Parent-ownership check (get() on the PARENT
      // surveyReports/{reportId}, not resource.data of the child) so this
      // subcollection is never more permissive than the document it audits
      // — admin, viewer, the assigned engineer, or the nominated approver,
      // same as the parent rule above. A denormalised field on the child (the
      // pattern used on workOrders/surveyReports themselves in task 1b)
      // isn't an option here: the 'submit' snapshot's whole reason for
      // existing is to hold a payload copy, and copying assignedTo/
      // approverUid onto every entry would need to be kept in sync forever
      // for no benefit when the parent already has them. Firestore dedupes
      // identical document reads within one rule evaluation, so listing N
      // updates for one survey costs one extra read, not N.
      //
      // read and create are split (they were one `allow read, create` line)
      // precisely so the viewer can be admitted to the read half only.
      match /updates/{updateId} {
        // READ must match the PARENT's scope exactly, or a stage owner whose
        // stage has cleared can still see the survey (granted above via
        // approvalStageOwnerUids) but not its History — the inconsistency the
        // flat uid array was introduced to avoid.
        //
        // A subcollection cannot read the parent's array off its own
        // resource.data the way the parent rule does, so it comes via get() on
        // the parent. Firestore dedupes identical document reads within one
        // rule evaluation, so this shares the single parent read the branches
        // below already perform — no extra billed read, no extra lookup
        // against the 10-access ceiling.
        //
        // .get('approvalStageOwnerUids', []) for the same reason as the parent
        // rule: pre-chain surveys have no such field and a bare access on a
        // missing field is an evaluation error, not false. The approverUid
        // branch is KEPT so those documents stay readable by their single
        // approver — purely additive.
        allow read: if isAdmin()
          || isViewer()
          || get(/databases/$(database)/documents/surveyReports/$(reportId)).data.assignedTo  == request.auth.uid
          || get(/databases/$(database)/documents/surveyReports/$(reportId)).data.approverUid == request.auth.uid
          || request.auth.uid in get(/databases/$(database)/documents/surveyReports/$(reportId))
                                   .data.get('approvalStageOwnerUids', []);
        // CREATE is deliberately NOT widened to stage owners generally: a
        // History entry is written by the ACTIVE transition (the engineer
        // submitting, or the live stage owner deciding), never by someone who
        // merely retains read access to a stage they already cleared.
        //
        // NOTE: this restriction is currently defeated by the recursive
        // /{path=**}/updates rule at the bottom of this file, which grants
        // create to any authenticated non-viewer. See the comment there.
        allow create: if !isViewer() && (isAdmin()
          || get(/databases/$(database)/documents/surveyReports/$(reportId)).data.assignedTo  == request.auth.uid
          || get(/databases/$(database)/documents/surveyReports/$(reportId)).data.approverUid == request.auth.uid);
        allow update, delete: if false;   // immutable audit trail
      }
    }

    match /bulkUploads/{uploadId} {
      // Bulk-upload documents are admin-readable (+ viewer, for oversight) —
      // field engineers never see them. Writing one means running an upload,
      // which stays admin-only.
      allow read:  if isAdmin() || isViewer();
      allow write: if isAdmin();
    }

    // CollectionGroup rule for the Reports page collectionGroup('updates') query.
    // Firestore requires a top-level wildcard match for cross-collection queries —
    // the nested match inside /tasks/{taskId} above only covers direct access.
    // This is also the only rule covering siteTasks/{id}/updates (the site-task
    // submission history), so the viewer is admitted here for that too.
    // CollectionGroup rule for the Reports page collectionGroup('updates') query.
    // Firestore requires a top-level wildcard match for cross-collection queries —
    // the nested matches above only cover direct access.
    //
    // create is `false` HERE ON PURPOSE. Firestore ORs every matching rule, so
    // while this granted create to any authenticated non-viewer it silently
    // overrode the parent-ownership checks in the nested rules — anyone with an
    // account could append a forged entry to any survey's or site task's audit
    // trail. (Existing entries were always immutable; this was append-only
    // forgery, not tampering, but the trail backs a document headed for
    // government vetting.)
    //
    // Every legitimate create is now granted by a nested rule scoped to that
    // collection's own parties, and there are exactly three writers:
    //   tasks/{id}/updates         — the nested rule under /tasks
    //   siteTasks/{id}/updates     — the nested rule under /siteTasks
    //   surveyReports/{id}/updates — the nested rule under /surveyReports
    // A NEW /updates subcollection would therefore get no create access until
    // it is given a nested rule of its own. That is the intended failure mode:
    // loud and immediate, rather than silently world-writable.
    match /{path=**}/updates/{updateId} {
      allow read: if isAdmin() || isViewer();
      allow create: if false;
      allow update, delete: if false;
    }
  }
}
